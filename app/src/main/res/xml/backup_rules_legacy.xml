<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older can't tell cloud backup from phone-to-phone
     transfer, so everything is excluded to keep memes off the cloud.
     The export ZIP (coming in a later phase) is the way to move memes there. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
